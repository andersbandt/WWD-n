/dts-v1/;
#include <nordic/nrf52833_qdaa.dtsi>
#include <dt-bindings/pwm/pwm.h>
#include "nrf52833_ders-pinctrl.dtsi"

/ {
	model = "Anders' WWD version of nRF52833";
	compatible = "Flavo,nrf52833-ders";

	chosen {
		zephyr,sram        = &sram0;
		zephyr,flash       = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,console     = &cdc_acm_uart0;
		zephyr,shell-uart  = &cdc_acm_uart0;
	};

	aliases {
		watchdog0 = &wdt0;
		display0  = &st7735s;
		led0      = &led_status;
		led1      = &led_status;
		led2      = &led_status;
	};

	leds {
		compatible = "gpio-leds";
		led_status: led_status {
			/* BISECT 2026-07-27: was <&mcp23008 5 ...> — MCP23008 node disabled
			 * below to test whether its auto-init is implicated in a boot hang.
			 * Redirected to a spare, otherwise-unused gpio1 pin so this compiles;
			 * LED1 remains non-functional either way (expander not populated). */
			gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;  /* was LED1 MCP23008 GP5 */
		};
	};

	power_ctrl {
		compatible = "gpio-leds";
		vbat_div_en: vbat_div_en {
			gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;  /* was VBAT_DIV_GPIO MCP23008 GP4 */
		};
		boost_sel: boost_sel {
			gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;  /* was BOOST_SEL MCP23008 GP6 */
		};
	};

	zephyr,user {
		io-channels = <&adc 2>;  /* AIN2 = P0.04: battery voltage divider output */
	};

	buttons {
		compatible = "gpio-keys";
		button1: button1 {
			gpios = <&gpio1 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;  /* was BUTTON1 MCP23008 GP1 */
		};
		button2: button2 {
			gpios = <&gpio1 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;  /* was BUTTON2 MCP23008 GP2 */
		};
		button3: button3 {
			gpios = <&gpio1 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;  /* was BUTTON3 MCP23008 GP3 */
		};
		button4: button4 {
			gpios = <&gpio1 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;  /* was BUTTON4 MCP23008 GP0 */
		};
	};
};

/* nRESET on P0.18 */
&uicr {
	gpio-as-nreset;

	/* P0.09 and P0.10 are the NFC antenna pins (NFC1/NFC2) and come up in NFC
	 * mode, not as GPIOs. Both are used by the IMU here — P0.10 is its SPI chip
	 * select and P0.09 is INT1 — so without this the IMU is unreachable: CS
	 * reads stuck low and never frames a transaction. */
	nfct-pins-as-gpios;
};

/* RTC2: 1-second tick source (RTC0 reserved for BLE, RTC1 is kernel timer) */
&rtc2 {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

/* PWM0: display backlight (DISP_LED_PWM, P0.11) drives the gate of the
 * LCD-power NMOS. Full duty cycle = gate held high = 100% brightness. */
&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

/* SPI1: flash, IMU, display */
&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";

	/* CS: NVS flash P0.20, IMU P0.10, display P0.28 */
	cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>,
	           <&gpio0 10 GPIO_ACTIVE_LOW>,
	           <&gpio0 28 GPIO_ACTIVE_LOW>;

	mt29f: mt29f@0 {
		compatible = "micron,mt29f";
		reg = <0>;
		spi-max-frequency = <1000000>;
		frame-format = <0>;
		status = "okay";
	};

	icm42670p: icm42670p@1 {
		compatible = "tdk,icm42670p";
		reg = <1>;
		spi-max-frequency = <8000000>;
		int-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;   /* IMU_INT1 P0.09 */
		accel-hz = <100>;
		gyro-hz  = <100>;
		accel-fs = <2>;
		gyro-fs  = <250>;
		status = "okay";
	};

	st7735s: st7735s@2 {
		compatible = "waveshare,st7735s";
		reg = <2>;
		spi-max-frequency = <8000000>;
		dc-gpios    = <&gpio0    29 GPIO_ACTIVE_HIGH>;  /* DISP_DC P0.29 */
		reset-gpios = <&gpio1  7 GPIO_ACTIVE_LOW>;   /* BISECT: was DISP_RESET MCP23008 GP7 */
		pwms        = <&pwm0 0 PWM_USEC(100) PWM_POLARITY_NORMAL>; /* DISP_LED_PWM P0.11, 10 kHz */
		status = "okay";
	};
};

/* I2C0: MCP23008 GPIO expander (buttons, LED, display reset, boost) */
&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	mcp23008: mcp23008@20 {
		compatible = "microchip,mcp23008";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		int-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;   /* IO_INT P0.03 */
		/* BISECT 2026-07-27: disabled to test whether the driver's auto-init
		 * (POST_KERNEL, fails every boot since 0x20 doesn't ACK — not
		 * populated on this board) is implicated in a pre-nvs_init() hang.
		 * All consumers above temporarily redirected to spare gpio1 pins so
		 * the build still links. Revert (status="okay", point consumers back
		 * at &mcp23008) once this test is done either way. */
		status = "disabled";
	};

	rv3028: rv3028@52 {
		compatible = "microcrystal,rv3028";
		reg = <0x52>;
		backup-switch-mode = "direct";            /* coin cell on VBACKUP */
		int-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;   /* RTC_INT P0.05 */
		/* RTC_CLKOUT is wired to XL1 (P0.00) — no crystal is populated on
		 * this board, so this is the intended LF clock source. The driver
		 * stores this in the RV-3028's EEPROM, so CLKOUT comes up from POR
		 * without needing I2C first. Omitting this property drives CLKOUT
		 * LOW, which would leave the SoC with no LF source at all. */
		clkout-frequency = <32768>;
		/* The RV-3028 does not respond on I2C this early after a cold
		 * power-on, so the automatic POST_KERNEL init fails with -ENODEV
		 * and Zephyr latches that failure permanently (do_device_init()
		 * sets initialized=true even on error, so device_init() then
		 * returns -EALREADY). Defer the bind and let the application call
		 * device_init() once the part is awake. */
		zephyr,deferred-init;
		status = "okay";
	};
};

/* ADC: battery voltage sense on AIN2 (P0.04), 1:2 divider, enable via VBAT_DIV_GPIO (MCP23008 GP4) */
&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN2>;  /* P0.04 */
	};
};

/* USB CDC console — D+/D- are hardware pins, no pinctrl needed.
 * Two ACM instances on one composite USB device: uart0 stays the
 * human-readable console/shell/log stream exactly as before; uart1 is a
 * second, independent /dev/ttyACM* the host uses purely for the binary
 * host<->device command protocol (src/comm/protocol.[ch]), so command
 * framing never has to coexist with interleaved log text on the wire. */
zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};

	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(48)>;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 DT_SIZE_K(220)>;
		};

		slot1_partition: partition@43000 {
			label = "image-1";
			reg = <0x00043000 DT_SIZE_K(220)>;
		};

		storage_partition: partition@7a000 {
			label = "storage";
			reg = <0x0007a000 DT_SIZE_K(24)>;
		};
	};
};